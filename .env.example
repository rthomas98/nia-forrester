# Convex deployment values created by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Public site URL. Use http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Keep staged products hidden in production until launch review is complete.
NEXT_PUBLIC_COMMUNITY_ENABLED=false
NEXT_PUBLIC_MEMBERSHIP_ENABLED=false

# Better Auth / Convex
BETTER_AUTH_SECRET=
ADMIN_EMAILS=
INTERNAL_API_SECRET=
MIGRATION_SECRET=

# Transactional email
RESEND_API_KEY=
EMAIL_FROM=Nia Forrester <readers@niaforrester.com>
CONTACT_TO_EMAIL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_READER_MONTHLY_PRICE_ID=
STRIPE_READER_ANNUAL_PRICE_ID=
STRIPE_INNER_MONTHLY_PRICE_ID=
STRIPE_INNER_ANNUAL_PRICE_ID=
STRIPE_WRITERS_MONTHLY_PRICE_ID=
STRIPE_WRITERS_ANNUAL_PRICE_ID=

# Optional override for the controlled Wix staging import
LEGACY_SITEMAP_URL=https://www.niaforrester.com/sitemap.xml
